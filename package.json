{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "lightsurge",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/examples/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.4.6",
      "@total-typescript/ts-reset": "0.6.1",
      "@tsconfig/bun": "1.0.10",
      "@tsconfig/node22": "22.0.5",
      "@types/bun": "1.3.11",
      "@types/node": "22.19.15",
      "typescript": "5.9.3"
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@tsconfig/node22": "catalog:",
    "husky": "9.1.7",
    "turbo": "2.8.14"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
